<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<title>RadarNode</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
:root{--rowh:28px}
[data-theme="dark"]{--bg:#0d1117;--bg2:#080d12;--surf:#161b22;--bord:#21262d;--bord2:#30363d;--rowb:#1b2129;--txt:#e6edf3;--txt2:#c9d1d9;--mut:#9aa7b4;--acc:#58a6ff;--warn:#f0883e;--ok:#3fb950;--dang:#f85149;--vio:#bc8cff;--gold:#e3b341;--movbg:#1c1207;--hov:#11161d;--scope:#080d12;--wedge:#050d14;--grid:#35597d;--grid2:#29456a;--ghost:#3a5a6a;--cofill:#07111a;--costr:#1e4a70;--cotop:#2a5a80;--cotxt:#e0e0e0;--btnbd:#55606e;--btnbg:#222b36;--btnbgh:#2d3846;--goldbg:rgba(227,179,65,.12);--hm0:#1a2030;--hmlo:#235a23;--hmhi:#2d7a2d;--hmal:#8b4513;--hmal2:#b55a1a}
[data-theme="light"]{--bg:#f6f8fa;--bg2:#eceff3;--surf:#ffffff;--bord:#d0d7de;--bord2:#b8c0c9;--rowb:#e4e8ec;--txt:#0f1720;--txt2:#1f2933;--mut:#57616b;--acc:#0a5ecc;--warn:#b3560b;--ok:#1a7f37;--dang:#c22b23;--vio:#7a3fd0;--gold:#8a6100;--movbg:#fff4e6;--hov:#eef1f5;--scope:#e8edf2;--wedge:#dbe3ec;--grid:#7d9bb8;--grid2:#9db2c6;--ghost:#6f8a9c;--cofill:#ffffff;--costr:#5c86b0;--cotop:#3a6d9c;--cotxt:#0f1720;--btnbd:#9aa5b1;--btnbg:#ffffff;--btnbgh:#eef1f5;--goldbg:rgba(138,97,0,.10);--hm0:#dfe5ec;--hmlo:#9ed3a1;--hmhi:#3f8f43;--hmal:#e2ae82;--hmal2:#c05f1c}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--bg);color:var(--txt2);font-family:-apple-system,"SF Pro Text","Segoe UI",sans-serif;height:100vh;height:100dvh;overflow:hidden}
body{display:flex;flex-direction:column}
header{display:flex;align-items:center;gap:10px;padding:6px 14px;border-bottom:1px solid var(--bord);flex-shrink:0;min-height:42px;background:var(--bg)}
.logo{font-size:14px;font-weight:700;letter-spacing:.1em;color:var(--txt)}
.node-tag{font-size:12px;color:var(--mut);font-family:monospace}
.hsp{flex:1}
.alarm-dot{width:10px;height:10px;border-radius:50%;background:var(--bord);transition:all .2s;flex-shrink:0}
.alarm-dot.on{background:var(--warn);box-shadow:0 0 8px rgba(240,136,62,.7)}
.state-pill{font-size:10px;letter-spacing:.1em;border:1px solid;padding:2px 8px;border-radius:3px}
.s-idle{color:var(--mut);border-color:var(--bord2)}
.s-triggered{color:var(--gold);border-color:var(--gold)}
.s-linger{color:var(--acc);border-color:var(--acc)}
.s-baseline{color:var(--gold);border-color:var(--gold);background:var(--goldbg)}
.hbtn{padding:6px 14px;border-radius:5px;border:1px solid var(--btnbd);background:var(--btnbg);color:var(--txt);cursor:pointer;font-size:13px;font-weight:600;font-family:inherit;letter-spacing:.04em}
.hbtn:hover:not(:disabled){border-color:var(--acc);color:var(--acc);background:var(--btnbgh)}
.hbtn:disabled{opacity:.45;cursor:default}
.icbtn{width:30px;height:30px;padding:0;border:none;background:transparent;color:var(--mut);cursor:pointer;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.icbtn:hover{color:var(--txt);background:var(--surf)}
.icbtn svg{width:17px;height:17px;display:block}
main{flex:1;display:flex;overflow:hidden;min-height:0}
.lcol{width:280px;flex-shrink:0;display:flex;flex-direction:column;background:var(--bg);min-height:0}
.scope-wrap{flex:1;min-height:0;position:relative;background:var(--scope);overflow:hidden}
.scope-wrap svg{position:absolute;inset:0;width:100%;height:100%}
.ss{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:var(--bord);flex-shrink:0}
.sc{background:var(--bg);padding:6px 10px}
.sc-l{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--mut);line-height:1.3}
.sc-v{font-size:22px;font-weight:400;color:var(--txt);line-height:1.2;white-space:nowrap;overflow:hidden;font-family:monospace}
.sc-v.hi{color:var(--txt);font-weight:600}
.sc-v.alm{color:var(--warn);font-weight:700;font-size:20px}
.sc-v.sm{font-size:18px}
.sc-v.dim{color:var(--mut)}
.rh{width:10px;flex-shrink:0;background:var(--bg);border-left:1px solid var(--bord);cursor:col-resize;position:relative;transition:background .15s}
.rh::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:2px;height:28px;border-radius:1px;background:var(--bord2)}
.rh:hover,.rh.drag{background:var(--surf)}
.rh:hover::after,.rh.drag::after{background:var(--acc)}
.rcol{flex:1;display:flex;flex-direction:column;min-height:0;background:var(--bg)}
.rscroll{flex:1;min-height:0;overflow-y:auto}
.rscroll::-webkit-scrollbar{width:6px}
.rscroll::-webkit-scrollbar-thumb{background:var(--bord2);border-radius:3px}
.sh{display:flex;align-items:center;gap:8px;padding:0 12px;min-height:38px;background:var(--surf);border-top:1px solid var(--bord);border-bottom:1px solid var(--bord);flex-shrink:0}
.sh-l{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--txt);flex:0 0 auto;white-space:nowrap}
.sh .hbtn{padding:4px 12px;font-size:12px}
.shsel{font-size:12px;font-family:inherit;color:var(--txt);background:var(--btnbg);border:1px solid var(--btnbd);border-radius:5px;padding:4px 7px;cursor:pointer;flex-shrink:0}
.shsel:disabled{opacity:.5;cursor:default}
.hbtn.prim{border-color:var(--acc);color:var(--acc);background:rgba(88,166,255,.12);font-weight:600}
.hbtn.prim:hover:not(:disabled){background:var(--acc);color:#fff}
.tgl{position:relative;display:inline-flex;flex-shrink:0;cursor:pointer}
.tgl input{position:absolute;opacity:0;width:0;height:0}
.tgl-t{width:38px;height:21px;border-radius:11px;background:var(--bord2);border:1px solid var(--bord2);transition:background .18s;display:block}
.tgl-t::after{content:'';position:absolute;top:3px;left:3px;width:15px;height:15px;border-radius:50%;background:var(--bg);transition:transform .18s}
.tgl input:checked+.tgl-t{background:var(--ok);border-color:var(--ok)}
.tgl input:checked+.tgl-t::after{transform:translateX(17px)}
.tgl input:focus-visible+.tgl-t{box-shadow:0 0 0 3px var(--accbg,rgba(88,166,255,.3))}
.sh-r{font-size:13px;color:var(--mut);margin-left:auto;flex-shrink:0}
.sh-r.live{color:var(--acc)}
.sr{display:flex;align-items:center;gap:6px;padding:0 12px;height:var(--rowh);border-bottom:1px solid var(--rowb);font-family:monospace;font-size:14px}
.si{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.sp2{font-size:14px;min-width:42px;color:var(--mut);font-weight:400}
.sp2.hi{color:var(--txt);font-weight:600}
.st{font-size:12px;border:1px solid var(--bord2);color:var(--mut);padding:1px 5px;border-radius:3px;min-width:46px;text-align:center;line-height:1.6}
.sm2{font-size:14px;color:var(--txt2);flex:0 0 auto;white-space:nowrap}
.sn2{font-size:13px;color:var(--txt2);flex:0 1 auto;flex-shrink:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.smf{font-size:12px;color:var(--mut);border:1px solid var(--bord2);border-radius:3px;padding:1px 5px;flex:0 1 auto;flex-shrink:6;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ss2{font-size:13px;color:var(--mut);flex-shrink:0;min-width:38px;text-align:right}
.sr .ctid{font-size:12px;color:var(--warn);flex-shrink:0}
.sr.mov{background:var(--movbg);border-left:2px solid var(--warn);padding-left:10px}
.sr.mov .sm2{color:var(--warn);font-weight:600}
.sdir{font-size:14px;font-weight:700;flex-shrink:0;width:13px;text-align:center;line-height:1}
.sdir.app{color:var(--dang)}
.sdir.rec{color:var(--acc)}
.st.wifi{color:var(--acc);border-color:var(--acc)}
.st.ble{color:var(--vio);border-color:var(--vio)}
.sbars{display:inline-flex;align-items:flex-end;gap:1px;height:13px;flex-shrink:0;margin-left:auto}
.sbars i{width:3px;background:var(--bord2);display:inline-block}
.sbars i:nth-child(1){height:4px}
.sbars i:nth-child(2){height:7px}
.sbars i:nth-child(3){height:10px}
.sbars i:nth-child(4){height:13px}
.sbars i.on{background:var(--ok)}
.gtabs{display:flex;background:var(--bg2);border-bottom:1px solid var(--bord);height:38px}
.gtab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:12px;color:var(--mut);letter-spacing:.06em;text-transform:uppercase;cursor:pointer;border-bottom:2px solid transparent;padding:2px 0}
.gtab svg{opacity:.5}
.gtab.act{color:var(--txt);border-bottom-color:var(--acc)}
.gtab.act svg{opacity:1}
.gbody{padding:8px 10px}
.gchart{width:100%;height:52px;display:block}
.g-foot{display:flex;justify-content:space-between;font-size:12px;color:var(--mut);margin-top:4px}
.g-legend{font-size:12px;color:var(--mut);margin-top:3px}
.g-legend span{margin-right:8px}
.traf{padding:4px 12px 6px}
.tstat{display:flex;gap:14px;padding:4px 0 6px}
.tsi{display:flex;flex-direction:column}
.tsi-l{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--mut);line-height:1.3}
.tsi-v{font-size:20px;font-weight:400;color:var(--txt2);line-height:1.2;font-family:monospace}
.tsi-v.hi{color:var(--txt)}
.tr-row{height:var(--rowh);display:flex;align-items:center;gap:8px;padding:0 12px;border-bottom:1px solid var(--rowb)}
.tr-lbl{font-size:14px;color:var(--txt2);min-width:130px}
.tr-val{font-size:14px;color:var(--mut);text-align:right;min-width:52px;font-family:monospace}
.tr-val.hi{color:var(--txt)}
.tr-track{flex:1;height:6px;border-radius:3px;background:var(--rowb);overflow:hidden}
.tr-fill{height:100%;border-radius:3px;transition:width .6s}
.tf-phys{background:linear-gradient(90deg,#2f7d32,#57b25c)}
.tf-dev{background:linear-gradient(90deg,#1e3060,#3f7fd0)}
.dr{display:flex;align-items:center;gap:10px;padding:7px 12px;min-height:38px;border-bottom:1px solid var(--rowb);font-size:14px}
.dd{width:9px;height:9px;border-radius:50%;background:var(--bord);flex-shrink:0}
.dc{color:var(--txt);font-family:monospace;font-weight:700;flex-shrink:0;min-width:58px}
.dmeta{flex:1;min-width:0;display:flex;flex-wrap:wrap;gap:5px}
.chip{font-size:12px;color:var(--mut);border:1px solid var(--bord2);border-radius:4px;padding:1px 7px;white-space:nowrap}
.chip.on{color:var(--ok);border-color:var(--ok)}
.dage{font-size:14px;font-family:monospace;color:var(--mut);flex-shrink:0;min-width:46px;text-align:right}
.da{color:var(--mut);flex:1;font-size:13px}
.lr{display:flex;align-items:center;gap:6px;padding:0 12px;height:var(--rowh);border-bottom:1px solid var(--rowb);cursor:pointer;font-family:monospace;font-size:14px}
.lr:hover{background:var(--hov)}
.lr-hl{background:rgba(88,166,255,.15)!important;transition:background .8s}
.lr-sel{background:rgba(227,179,65,.10)!important;border-left:2px solid var(--gold)}
.lt{min-width:58px;color:var(--mut);font-size:13px;flex-shrink:0}
.ld{color:var(--txt2);flex:1}
.lc{color:var(--txt);flex-shrink:0}
.la2{color:var(--warn);font-weight:700;font-size:13px;flex-shrink:0;min-width:36px;text-align:right}
.lct{color:var(--mut);min-width:26px;text-align:right;font-size:13px;flex-shrink:0}
.lr-chev{color:var(--mut);flex-shrink:0;margin-left:2px;transition:transform .15s;font-size:13px}
.lr.open .lr-chev{transform:rotate(90deg)}
.lexp{display:none;background:var(--bg2);border-bottom:1px solid var(--rowb)}
.lr.open+.lexp{display:block}
.lexp-inner{padding:6px 12px 6px 34px;display:flex;flex-direction:column;gap:3px}
.lexp-c{font-family:monospace;font-size:13px;color:var(--txt2);display:flex;gap:8px}
.lexp-mac{color:var(--acc)}
.lexp-score{color:var(--txt)}
.lexp-name{color:var(--mut)}
.lexp-empty{font-size:13px;color:var(--mut);font-style:italic;padding:3px 0}
.gchart-empty{display:none;text-align:center;font-size:13px;color:var(--mut);padding:16px 0}
#cfg{position:fixed;top:0;right:0;width:min(420px,100vw);height:100%;background:var(--bg);border-left:1px solid var(--bord);padding:20px;overflow-y:auto;z-index:200;transform:translateX(110%);transition:transform .3s cubic-bezier(.4,0,.2,1)}
#cfg.open{transform:none;box-shadow:-8px 0 32px rgba(0,0,0,.5)}
#cfg h2{font-size:19px;font-weight:700;color:var(--txt);margin-bottom:4px}
#cfg .sub{font-size:13px;color:var(--mut);margin-bottom:18px}
.cfg-sec{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--acc);margin:22px 0 10px}
.cfg-close{float:right;background:var(--btnbg);border:1px solid var(--btnbd);border-radius:5px;color:var(--txt2);cursor:pointer;padding:5px 12px;font-size:13px;font-family:inherit}
.cfg-close:hover{border-color:var(--warn);color:var(--warn)}
.cfg-lbl{display:block;font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--txt2);margin:14px 0 6px}
.cfg-hint{display:block;font-size:12px;font-weight:400;text-transform:none;letter-spacing:0;color:var(--mut);margin-top:3px}
.cfg-inp{width:100%;background:var(--surf);border:1px solid var(--bord2);border-radius:6px;color:var(--txt);padding:10px 12px;font-family:inherit;font-size:15px;outline:none}
.cfg-inp:focus{border-color:var(--acc);box-shadow:0 0 0 3px rgba(88,166,255,.2)}
select.cfg-inp{cursor:pointer}
.cfg-btn{width:100%;margin-top:14px;padding:11px;border-radius:6px;border:1px solid var(--acc);background:rgba(88,166,255,.12);color:var(--acc);cursor:pointer;font-size:14px;font-weight:600;font-family:inherit;letter-spacing:.03em}
.cfg-btn:hover{background:var(--acc);color:#fff}
.cfg-btn.sec{border-color:var(--btnbd);color:var(--txt);background:var(--btnbg);margin-top:8px}
.cfg-btn.sec:hover{border-color:var(--txt);color:var(--txt);background:var(--btnbgh)}
.cfg-hr{border:none;border-top:1px solid var(--bord);margin:18px 0}
pre#stats-out{font-size:13px;color:var(--txt2);margin-top:10px;white-space:pre-wrap;line-height:1.6;font-family:monospace}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
.pill-live{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--acc);animation:pulse 1.5s ease-in-out infinite}
.pill-live i{width:7px;height:7px;border-radius:50%;background:var(--acc);box-shadow:0 0 8px var(--acc);flex-shrink:0}
@keyframes dp{0%,100%{opacity:.75}50%{opacity:1}}
@keyframes trR{0%{stroke-dashoffset:55;opacity:0}15%{opacity:1}85%{opacity:.7}100%{stroke-dashoffset:0;opacity:0}}
@keyframes trL{0%{stroke-dashoffset:-55;opacity:0}15%{opacity:1}85%{opacity:.7}100%{stroke-dashoffset:0;opacity:0}}
.trR{animation:trR 2.4s ease-in-out infinite}
.trL{animation:trL 2.4s ease-in-out infinite}
.tdot{transition:opacity .5s}
.tdot.stale{opacity:.25}
.ghost{opacity:.4}
</style>
</head>
<body>
<header>
  <span class="logo">RADARNODE</span>
  <span class="node-tag" id="node-id">--</span>
  <div class="alarm-dot" id="led"></div>
  <span class="state-pill s-idle" id="state-badge">IDLE</span>
  <span class="state-pill s-baseline" id="bl-badge" style="display:none">BASELINE</span>
  <div class="hsp"></div>
  <button class="icbtn" id="privBtn" onclick="togglePrivacy()" aria-label="Toggle redaction"></button>
  <button class="icbtn" id="themeBtn" title="Toggle light/dark" aria-label="Toggle theme"></button>
  <button class="hbtn" onclick="document.getElementById('cfg').classList.toggle('open')">CONFIG</button>
</header>
<main>
  <div class="lcol" id="lcol">
    <div class="ss">
      <div class="sc"><div class="sc-l">Dist</div><div class="sc-v dim" id="sd">--</div></div>
      <div class="sc"><div class="sc-l">Class</div><div class="sc-v dim sm" id="scls">--</div></div>
      <div class="sc"><div class="sc-l">Deg</div><div class="sc-v dim sm" id="sang">--</div></div>
    </div>
    <div class="ss">
      <div class="sc"><div class="sc-l">Speed</div><div class="sc-v dim" id="sv">--</div></div>
      <div class="sc"><div class="sc-l">Dir</div><div class="sc-v dim sm" id="sdir">--</div></div>
      <div class="sc"><div class="sc-l">SNR</div><div class="sc-v dim sm" id="ssnr">--</div></div>
    </div>
    <div class="scope-wrap">
      <svg id="scope" viewBox="0 0 220 322" preserveAspectRatio="xMidYMid meet">
        <defs>
          <clipPath id="fn1"><polygon points="110,320 54,0 166,0"/></clipPath>
          <filter id="glo" x="-150%" y="-150%" width="400%" height="400%"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <polygon points="110,320 54,0 166,0" fill="var(--wedge)" opacity=".85"/>
        <g clip-path="url(#fn1)">
          <circle cx="110" cy="320" r="70"  fill="none" stroke="var(--grid)" stroke-width=".9"/>
          <circle cx="110" cy="320" r="140" fill="none" stroke="var(--grid)" stroke-width=".9"/>
          <circle cx="110" cy="320" r="210" fill="none" stroke="var(--grid)" stroke-width=".9"/>
          <circle cx="110" cy="320" r="280" fill="none" stroke="var(--grid)" stroke-width=".9"/>
        </g>
        <line x1="110" y1="320" x2="54"  y2="0" stroke="var(--grid)" stroke-width=".9"/>
        <line x1="110" y1="320" x2="166" y2="0" stroke="var(--grid)" stroke-width=".9"/>
        <line x1="110" y1="320" x2="110" y2="0" stroke="var(--grid2)" stroke-width=".7" stroke-dasharray="3,6"/>
        <text x="114" y="253" font-size="7" fill="var(--mut)" font-family="monospace">25m</text>
        <text x="114" y="183" font-size="7" fill="var(--mut)" font-family="monospace">50m</text>
        <text x="114" y="113" font-size="7" fill="var(--mut)" font-family="monospace">75m</text>
        <text x="114" y="43"  font-size="7" fill="var(--mut)" font-family="monospace">100m</text>
        <g id="hist-trails"></g>
        <g id="pinned-trail"></g>
        <g id="live-trail"></g>
        <g id="sec-dots"></g>
        <circle id="ghost" cx="110" cy="295" r="4" fill="none" stroke="var(--ghost)" stroke-width=".8" stroke-dasharray="2,3" class="ghost" style="display:none"/>
        <circle id="tdot" cx="110" cy="295" r="5" fill="#3fb950" filter="url(#glo)" class="tdot" style="display:none"/>
        <g id="callout" style="display:none">
          <line id="co-trace" x1="110" y1="295" x2="168" y2="295" stroke="var(--costr)" stroke-width=".8" stroke-dasharray="4 8"/>
          <polygon id="co-poly" points="168,295 175,282.5 218,282.5 218,307.5 175,307.5" fill="var(--cofill)" stroke="var(--costr)" stroke-width=".8"/>
          <line id="co-top" x1="175" y1="282.5" x2="218" y2="282.5" stroke="var(--cotop)" stroke-width="1.2"/>
          <text id="co-cls" x="178" y="297" font-size="10" fill="var(--cotxt)" font-family="monospace" font-weight="700">--</text>
          <text id="co-info" x="178" y="308" font-size="9" fill="var(--mut)" font-family="monospace">--</text>
        </g>
      </svg>
    </div>
  </div>
  <div class="rh" id="rh"></div>
  <div class="rcol">
    <div class="rscroll">
      <div class="sh" id="sec-scan">
        <span class="sh-l">RF Enrichment</span>
        <label class="tgl" title="On a radar trigger, also sweep BLE + WiFi">
          <input type="checkbox" id="rfTgl"><span class="tgl-t"></span>
        </label>
        <button id="scanBtn" class="hbtn prim" title="Force a sweep now">Sweep now</button>
        <span class="sh-r" id="ccount"></span>
      </div>
      <div id="candidates"></div>
      <div class="sh"><span class="sh-l">Activity</span></div>
      <div class="gtabs" id="gtabs">
        <div class="gtab act" onclick="switchTab(this,'tab-timeline')">
          <svg width="28" height="12" viewBox="0 0 28 12"><rect x="0" y="8" width="3" height="4" fill="#2d5a2d"/><rect x="4" y="2" width="3" height="10" fill="#8b4513"/><rect x="8" y="5" width="3" height="7" fill="#2d5a2d"/><rect x="12" y="9" width="3" height="3" fill="#2d5a2d"/><rect x="16" y="0" width="3" height="12" fill="#8b4513"/><rect x="20" y="6" width="3" height="6" fill="#4a4020"/><rect x="24" y="4" width="3" height="8" fill="#2d5a2d"/></svg>
          <span>Timeline</span>
        </div>
        <div class="gtab" onclick="switchTab(this,'tab-heatmap')">
          <svg width="28" height="12" viewBox="0 0 28 12"><rect x="0" y="0" width="5" height="5" fill="#1a3a1a"/><rect x="6" y="0" width="5" height="5" fill="#235a23"/><rect x="12" y="0" width="5" height="5" fill="#2d7a2d"/><rect x="18" y="0" width="5" height="5" fill="#8b4513"/><rect x="24" y="0" width="4" height="5" fill="#235a23"/><rect x="0" y="7" width="5" height="5" fill="#235a23"/><rect x="6" y="7" width="5" height="5" fill="#b55a1a"/><rect x="12" y="7" width="5" height="5" fill="#2d7a2d"/><rect x="18" y="7" width="5" height="5" fill="#235a23"/><rect x="24" y="7" width="4" height="5" fill="#8b4513"/></svg>
          <span>Heatmap</span>
        </div>
        <div class="gtab" onclick="switchTab(this,'tab-distance')">
          <svg width="28" height="12" viewBox="0 0 28 12"><polyline points="0,8 4,7 8,5 12,6 16,3 20,4 24,1 28,2" fill="none" stroke="var(--acc)" stroke-width="1.5" stroke-linejoin="round"/><circle cx="16" cy="3" r="1.5" fill="#8b4513"/><circle cx="24" cy="1" r="1.5" fill="#8b4513"/></svg>
          <span>Distance</span>
        </div>
      </div>
      <div class="gbody" id="tab-timeline">
        <svg class="gchart" id="chart-timeline" viewBox="0 0 220 44" preserveAspectRatio="none"></svg>
        <div class="gchart-empty" id="chart-timeline-empty">no data</div>
        <div class="g-foot"><span>-11h</span><span>Now</span></div>
        <div class="g-legend"><span style="color:#3fb950">normal</span><span style="color:#f0883e">alarm</span></div>
      </div>
      <div class="gbody" id="tab-heatmap" style="display:none">
        <svg class="gchart" id="chart-heatmap" viewBox="0 0 220 34" preserveAspectRatio="none"></svg>
        <div class="gchart-empty" id="chart-heatmap-empty">insufficient data</div>
        <div class="g-foot"><span>oldest</span><span style="color:#adbac7">hour x day</span><span>newest</span></div>
        <div class="g-legend"><span style="color:#3fb950">detections</span><span style="color:#f0883e">alarms</span></div>
      </div>
      <div class="gbody" id="tab-distance" style="display:none">
        <svg class="gchart" id="chart-distance" viewBox="0 0 220 44" preserveAspectRatio="none"></svg>
        <div class="gchart-empty" id="chart-distance-empty">no data</div>
        <div class="g-foot"><span>100m</span><span style="color:#58a6ff">50m</span><span>0m</span></div>
        <div class="g-legend"><span style="color:#58a6ff">distance</span><span style="color:#f0883e">alarm</span></div>
      </div>
      <div class="sh">
        <span class="sh-l">Traffic Baseline</span>
        <select class="shsel" id="bl-dur2" title="Learning duration">
          <option value="1">1 min</option>
          <option value="5" selected>5 min</option>
          <option value="10">10 min</option>
          <option value="15">15 min</option>
          <option value="30">30 min</option>
          <option value="60">60 min</option>
        </select>
        <button class="hbtn prim" id="bl-btn2" onclick="toggleBaseline2()">Start Baseline</button>
        <span class="sh-r" id="traf-state">NO BASELINE</span>
      </div>
      <div class="traf">
        <div class="tstat">
          <div class="tsi"><div class="tsi-l">Det/min</div><div class="tsi-v" id="traf-dpm">--</div></div>
          <div class="tsi"><div class="tsi-l">Devices</div><div class="tsi-v" id="traf-devn">--</div></div>
        </div>
        <div class="tr-row"><span class="tr-lbl">Physical presence</span><div class="tr-track"><div class="tr-fill tf-phys" id="traf-phys" style="width:0%"></div></div><span class="tr-val" id="traf-phys-pct">--</span></div>
        <div class="tr-row"><span class="tr-lbl">Device traffic</span><div class="tr-track"><div class="tr-fill tf-dev" id="traf-dev" style="width:0%"></div></div><span class="tr-val" id="traf-dev-pct">--</span></div>
      </div>
      <div class="sh"><span class="sh-l">DiGI Mesh</span><button id="meshStatusBtn" class="hbtn" style="margin-right:8px">Ping Nodes</button><span class="sh-r" id="mesh-cnt">--</span></div>
      <div id="mesh-list"></div>
      <div class="sh" id="sec-log">
        <span class="sh-l">Detection Log</span>
        <a class="hbtn" href="/api/detlog.jsonl" download style="text-decoration:none">DL</a>
        <button class="hbtn" onclick="clearDetLog()">CLR</button>
        <span class="sh-r" id="dlog-cnt">0</span>
      </div>
      <div id="det-log"></div>
    </div>
  </div>
</main>
<div id="cfg">
  <button class="cfg-close" onclick="document.getElementById('cfg').classList.remove('open')">close</button>
  <h2>Radar Config</h2>
  <p class="sub">Detection parameters</p>
  <div class="cfg-sec">Detection</div>
  <label class="cfg-lbl">Max Distance
    <span class="cfg-hint">Ignore targets beyond this range. 1-100 m</span></label>
  <input class="cfg-inp" type="number" id="c-md" min="1" max="100">
  <label class="cfg-lbl">Direction
    <span class="cfg-hint">Which way a target must travel to count</span></label>
  <select class="cfg-inp" id="c-dir">
    <option value="0">Away from sensor</option>
    <option value="1">Towards sensor</option>
    <option value="2">Both directions</option>
  </select>
  <label class="cfg-lbl">Min Speed
    <span class="cfg-hint">Slower targets are ignored. 0-250 km/h</span></label>
  <input class="cfg-inp" type="number" id="c-ms" min="0" max="250">
  <label class="cfg-lbl">Report Delay
    <span class="cfg-hint">Sensor-side hold before reporting. 0-255</span></label>
  <input class="cfg-inp" type="number" id="c-dl" min="0" max="255">

  <div class="cfg-sec">Sensitivity</div>
  <label class="cfg-lbl">Trigger Count
    <span class="cfg-hint">Consecutive hits before a target is reported. 1-10</span></label>
  <input class="cfg-inp" type="number" id="c-tr" min="1" max="10">
  <label class="cfg-lbl">SNR Threshold
    <span class="cfg-hint">Lower triggers more easily. Sensor default is 4</span></label>
  <select class="cfg-inp" id="c-snr">
    <option value="0">0 - most sensitive</option>
    <option value="1">1</option>
    <option value="2">2</option>
    <option value="3">3</option>
    <option value="4">4 - default</option>
    <option value="5">5</option>
    <option value="6">6</option>
    <option value="7">7</option>
    <option value="8">8 - least sensitive</option>
  </select>

  <div class="cfg-sec">Alarm</div>
  <label class="cfg-lbl">Alarm Distance
    <span class="cfg-hint">Raise the alarm inside this range. 1-100 m</span></label>
  <input class="cfg-inp" type="number" id="c-ad" min="1" max="100">
  <label class="cfg-lbl">Alarm Speed
    <span class="cfg-hint">Raise the alarm above this speed. 0-80 m/s</span></label>
  <input class="cfg-inp" type="number" id="c-as" min="0" max="80" step="0.1">

  <div class="cfg-sec">RF Enrichment</div>
  <label class="cfg-lbl">Sweep Cooldown
    <span class="cfg-hint">Minimum gap between BLE/WiFi sweeps. 0-600 s</span></label>
  <input class="cfg-inp" type="number" id="c-cd" min="0" max="600">
  <label class="cfg-lbl">Linger
    <span class="cfg-hint">Hold TRIGGERED this long after the last frame. 1-60 s</span></label>
  <input class="cfg-inp" type="number" id="c-lg" min="1" max="60">
  <label class="cfg-lbl">RSSI Floor
    <span class="cfg-hint">Drop devices weaker than this. -95 dBm is about 100 m line of sight</span></label>
  <input class="cfg-inp" type="number" id="c-rf" min="-100" max="-30">
  <label class="cfg-lbl">BLE Dwell
    <span class="cfg-hint">Listen window per sweep. Longer catches slow advertisers. 500-10000 ms</span></label>
  <input class="cfg-inp" type="number" id="c-bd" min="500" max="10000" step="100">
  <button class="cfg-btn" onclick="saveConfig()">Save Config</button>
  <button class="cfg-btn sec" onclick="loadStats()">Load Stats</button>
  <pre id="stats-out"></pre>
  <div class="cfg-hr"></div>
  <h2>Network</h2>
  <p class="sub" style="margin-bottom:10px">AP settings -- reboot to apply</p>
  <label class="cfg-lbl">SSID</label><input class="cfg-inp" type="text" id="c-ssid">
  <label class="cfg-lbl">Password</label><input class="cfg-inp" type="password" id="c-pass">
  <button class="cfg-btn" onclick="saveNet()">Save Network</button>
  <div class="cfg-hr"></div>
  <h2>Traffic Baseline</h2>
  <p class="sub">Learn ambient traffic, then monitor for changes</p>
  <label class="cfg-lbl">Duration (minutes)</label>
  <input class="cfg-inp" type="number" id="bl-dur" min="1" max="60" value="5">
  <button class="cfg-btn" id="bl-btn" onclick="toggleBaseline()">Start Baseline</button>
  <div id="bl-progress" style="display:none;font-size:13px;color:var(--gold);margin-top:8px">
    Learning... <span id="bl-elapsed">0</span>s / <span id="bl-total">0</span>s
  </div>
  <div class="cfg-hr"></div>
  <h2>Display</h2>
  <button class="cfg-btn" id="privacy-btn" onclick="togglePrivacy()"></button>
  <div class="cfg-hr"></div>
  <h2>Device</h2>
  <button class="cfg-btn sec" onclick="if(confirm('Reboot device?'))fetch('/api/restart',{method:'POST'})">Reboot Device</button>
</div>
<script>
var OX=110,OY=320,SCALE=280/100,MAX_DIST=100;
var radarState='idle',snrEma=null,lastWsTime=0,lastDist=0,lastAng=0;
var privacyMode=localStorage.getItem('privacyMode')==='1';
var lastCandidates=null,lastStats=null,pinnedTrack=null;
var detLog=[],trackPoints=[],lastDetectionTrack=[],blLearning=false,lastClearTime=null,lastDetTime=0;
var WS_R,WS_S;

fetch('/api/radar/config').then(function(r){return r.json()}).then(function(d){
  document.getElementById('c-md').value=d.maxDist;
  document.getElementById('c-dir').value=d.dir;
  document.getElementById('c-ms').value=d.minSpd;
  document.getElementById('c-dl').value=d.delay;
  document.getElementById('c-tr').value=d.trigger;
  document.getElementById('c-snr').value=d.snr;
  document.getElementById('c-ad').value=d.alarmDist;
  document.getElementById('c-as').value=d.alarmSpd;
  document.getElementById('c-cd').value=d.rfCooldown;
  document.getElementById('c-lg').value=d.linger;
  document.getElementById('c-rf').value=d.rssiFloor;
  document.getElementById('c-bd').value=d.bleDwell;
  var t=document.getElementById('rfTgl');if(t)t.checked=!!d.rfEnrich;
}).catch(function(e){console.error('radar config load failed',e);});
fetch('/api/info').then(function(r){return r.json()}).then(function(d){
  document.getElementById('node-id').textContent=d.node||'--';
}).catch(function(){});

function saveConfig(){
  fetch('/api/radar/config',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({maxDist:+document.getElementById('c-md').value,
      dir:+document.getElementById('c-dir').value,minSpd:+document.getElementById('c-ms').value,
      delay:+document.getElementById('c-dl').value,trigger:+document.getElementById('c-tr').value,
      snr:+document.getElementById('c-snr').value,alarmDist:+document.getElementById('c-ad').value,
      alarmSpd:+document.getElementById('c-as').value,
      rfEnrich:!!document.getElementById('rfTgl').checked,
      rfCooldown:+document.getElementById('c-cd').value,
      linger:+document.getElementById('c-lg').value,
      rssiFloor:+document.getElementById('c-rf').value,
      bleDwell:+document.getElementById('c-bd').value
    })}).then(function(r){return r.json()}).then(function(d){if(d.ok)alert('Saved')});}
function saveRfToggle(){
  var on=!!document.getElementById('rfTgl').checked;
  fetch('/api/radar/config').then(function(r){return r.json()}).then(function(d){
    d.rfEnrich=on;
    return fetch('/api/radar/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});
  }).catch(function(e){console.error('rf toggle save failed',e);});}
function renderStats(d){
  var txt=JSON.stringify(d,null,2);
  if(privacyMode){
    txt=txt.replace(/\b([A-Fa-f0-9]{2}:){5}[A-Fa-f0-9]{2}\b/g,'XX:XX');
    txt=txt.replace(/"name"\s*:\s*"[^"]*"/g,'"name": "REDACTED"');
    txt=txt.replace(/"ssid"\s*:\s*"[^"]*"/g,'"ssid": "REDACTED"');
  }
  document.getElementById('stats-out').textContent=txt;
}
function loadStats(){
  fetch('/api/radar/stats').then(function(r){return r.json()}).then(function(d){lastStats=d;renderStats(d)});}
function saveNet(){
  fetch('/api/config',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({ssid:document.getElementById('c-ssid').value,
      pass:document.getElementById('c-pass').value
    })}).then(function(r){return r.json()}).then(function(d){if(d.ok)alert('Saved -- reboot to apply')});}
var EYE='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 12S5.5 5 12 5s10.2 7 10.2 7-3.7 7-10.2 7S1.8 12 1.8 12z"/><circle cx="12" cy="12" r="3"/></svg>';
var EYEOFF='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 5.2A9.8 9.8 0 0112 5c6.5 0 10.2 7 10.2 7a17 17 0 01-3.2 4.1M6.2 6.7A17 17 0 001.8 12S5.5 19 12 19a9.6 9.6 0 004.2-.9"/><path d="M9.9 9.9a3 3 0 004.2 4.2"/><path d="M2 2l20 20"/></svg>';
function updatePrivacyBtn(){
  var btn=document.getElementById('privacy-btn');
  if(btn){
    btn.textContent=privacyMode?'Redact: ON':'Redact: OFF';
    btn.style.background=privacyMode?'var(--goldbg)':'var(--btnbg)';
    btn.style.borderColor=privacyMode?'var(--ok)':'var(--btnbd)';
    btn.style.color=privacyMode?'var(--ok)':'var(--txt)';
  }
  var ic=document.getElementById('privBtn');
  if(ic){
    ic.innerHTML=privacyMode?EYEOFF:EYE;
    ic.style.color=privacyMode?'var(--ok)':'';
    ic.title=privacyMode?'Redact ON â€” MACs and names hidden':'Redact OFF â€” showing MACs and names';
  }
}
function togglePrivacy(){
  privacyMode=!privacyMode;
  localStorage.setItem('privacyMode',privacyMode?'1':'0');
  updatePrivacyBtn();
  if(lastCandidates)renderCandidates(lastCandidates);
  if(lastStats)renderStats(lastStats);
}

function targetSVG(dist,ang){
  var r=dist*SCALE;
  var a=ang*Math.PI/180;
  return{x:OX+r*Math.sin(a),y:OY-r*Math.cos(a)};
}

function updateSVGTarget(dist,ang,alarm,cls,spd){
  var dot=document.getElementById('tdot');
  var ghost=document.getElementById('ghost');
  var co=document.getElementById('callout');
  if(dist<=0||dist>MAX_DIST){dot.style.display='none';return;}
  var p=targetSVG(dist,ang);
  dot.setAttribute('cx',p.x);
  dot.setAttribute('cy',p.y);
  dot.setAttribute('fill',alarm?'#f0883e':'#3fb950');
  dot.style.display='';
  dot.classList.remove('stale');
  ghost.setAttribute('cx',p.x);
  ghost.setAttribute('cy',p.y);
  ghost.style.display='none';
  var clsMap=['--','PERSON','VEHICLE'];
  var clsName=clsMap[cls]||'--';
  var info=dist.toFixed(0)+'m '+(spd*3.6).toFixed(0)+'k/h';
  var onRight=ang>=0;
  var cy=p.y;
  var poly,topLine,clsX,infoX;
  if(onRight){
    poly='168,'+cy+' 175,'+(cy-12.5)+' 218,'+(cy-12.5)+' 218,'+(cy+12.5)+' 175,'+(cy+12.5);
    topLine={x1:175,y1:cy-12.5,x2:218,y2:cy-12.5};
    clsX=178;infoX=178;
  }else{
    poly='52,'+cy+' 45,'+(cy-12.5)+' 2,'+(cy-12.5)+' 2,'+(cy+12.5)+' 45,'+(cy+12.5);
    topLine={x1:2,y1:cy-12.5,x2:45,y2:cy-12.5};
    clsX=5;infoX=5;
  }
  document.getElementById('co-poly').setAttribute('points',poly);
  document.getElementById('co-poly').setAttribute('stroke',alarm?'#8b4513':'var(--costr)');
  var tl=document.getElementById('co-top');
  tl.setAttribute('x1',topLine.x1);tl.setAttribute('y1',topLine.y1);
  tl.setAttribute('x2',topLine.x2);tl.setAttribute('y2',topLine.y2);
  tl.setAttribute('stroke',alarm?'var(--warn)':'var(--cotop)');
  var clsEl=document.getElementById('co-cls');
  clsEl.setAttribute('x',clsX);clsEl.setAttribute('y',cy-1);clsEl.textContent=clsName;
  clsEl.setAttribute('fill',alarm?'var(--cotxt)':'var(--mut)');
  var infoEl=document.getElementById('co-info');
  infoEl.setAttribute('x',infoX);infoEl.setAttribute('y',cy+10);
  infoEl.textContent=alarm?info+' ALM':info;
  infoEl.setAttribute('fill',alarm?'#f0883e':'#4a8aaa');
  var tr=document.getElementById('co-trace');
  tr.setAttribute('x1',p.x.toFixed(1));
  tr.setAttribute('y1',p.y.toFixed(1));
  tr.setAttribute('x2',onRight?'168':'52');
  tr.setAttribute('y2',cy.toFixed(1));
  tr.setAttribute('stroke',alarm?'#f0883e':'#3a6a8a');
  tr.setAttribute('class','');
  tr.getBoundingClientRect();
  tr.setAttribute('class',onRight?'trR':'trL');
  co.style.display='';
}

function connectWsR(){
  WS_R=new WebSocket('ws://'+location.host+'/ws');
  WS_R.onclose=function(){setTimeout(connectWsR,1500)};
  WS_R.onerror=function(){WS_R.close()};
  WS_R.onmessage=wsRMsg;
}
function connectWsS(){
  WS_S=new WebSocket('ws://'+location.host+'/scanws');
  WS_S.onclose=function(){setTimeout(connectWsS,1500)};
  WS_S.onerror=function(){WS_S.close()};
  WS_S.onmessage=wsSMsg;
}
var scanBusy=false;
function setScanBtn(state){
  var b=document.getElementById('scanBtn');if(!b)return;
  var cc=document.getElementById('ccount');
  if(state==='run'){b.disabled=true;b.textContent='Sweepingâ€¦';
    if(cc)cc.innerHTML='<span class="pill-live"><i></i>Sweeping</span>';}
  else if(state==='busy'){b.disabled=true;b.textContent='Busy';setTimeout(function(){setScanBtn('idle');},1500);}
  else{b.disabled=false;b.textContent='Sweep now';
    if(cc&&cc.querySelector('.pill-live'))cc.textContent='';}
}
(function(){
  var t=document.getElementById('rfTgl');
  if(t)t.addEventListener('change',saveRfToggle);
})();
document.getElementById('scanBtn').onclick=function(){
  if(blLearning)return;
  if(scanBusy)return;scanBusy=true;setScanBtn('run');
  fetch('/api/scan',{method:'POST'}).then(function(r){
    if(r.status===409){scanBusy=false;setScanBtn('busy');}
  }).catch(function(){scanBusy=false;setScanBtn('idle');});
  setTimeout(function(){scanBusy=false;setScanBtn('idle');},9000);
};
connectWsR();
connectWsS();
fetch('/api/events').then(function(r){return r.json()}).then(function(res){
  detLog=(res.data||res).reverse();
  renderDetLog();
  renderGraphs();
}).catch(function(){});

function wsRMsg(e){
  var d=JSON.parse(e.data);
  radarState=d.state||'idle';
  lastWsTime=performance.now();
  var dist=+d.d,ang=+d.a,spd=+d.v,snr=+d.snr,cls=+d.cls||0;
  lastDist=dist;lastAng=ang;
  if(dist>0&&dist<=MAX_DIST){
    lastDetTime=performance.now();
    var p=targetSVG(dist,ang);
    if(trackPoints.length===0){lastDetectionTrack=[];}
    var tp={x:p.x,y:p.y,t:performance.now(),alarm:!!d.alarm,dist:dist,ang:ang,spd:spd,cls:cls,ts:d.t||0};
    trackPoints.push(tp);
    if(trackPoints.length>40)trackPoints.shift();
    lastDetectionTrack.push({x:p.x,y:p.y,alarm:!!d.alarm,dist:dist,ang:ang,spd:spd,cls:cls});
    if(lastDetectionTrack.length>80)lastDetectionTrack.shift();
  }
  updateSVGTarget(dist,ang,!!d.alarm,cls,spd);
  renderSecDots(d.tgts,dist,ang);
  renderLiveTrail();
  if(dist>0&&dist<=MAX_DIST){
    var sdEl=document.getElementById('sd');
    sdEl.textContent=dist.toFixed(0)+'m';
    sdEl.className='sc-v hi';
    var svEl=document.getElementById('sv');
    svEl.textContent=(spd*3.6).toFixed(0)+'km/h';
    svEl.className='sc-v';
    var sdirEl=document.getElementById('sdir');
    sdirEl.textContent=d.dir>0?'TOWARD':d.dir<0?'AWAY':'--';
    sdirEl.className='sc-v sm'+(d.dir===0?' dim':'');
    snrEma=isNaN(snr)?snrEma:(snrEma===null?snr:0.7*snrEma+0.3*snr);
    var ssnrEl=document.getElementById('ssnr');
    ssnrEl.textContent=snrEma===null?'--':Math.round(snrEma);
    ssnrEl.className='sc-v sm'+(snrEma===null?' dim':'');
    var clsMap=['--','PERSON','VEHICLE'];
    var clsColors=['var(--mut)','var(--ok)','var(--warn)','var(--gold)'];
    var clsEl=document.getElementById('scls');
    clsEl.textContent=clsMap[cls]||'--';
    clsEl.style.color=clsColors[cls]||'var(--mut)';
    clsEl.className='sc-v sm'+(cls===0?' dim':' hi');
    var sangEl=document.getElementById('sang');
    sangEl.textContent=isNaN(ang)?'--':ang.toFixed(1)+'\u00b0';
    sangEl.className='sc-v sm'+(isNaN(ang)?' dim':'');
  }
  document.getElementById('led').classList.toggle('on',!!d.alarm);
  var sb=document.getElementById('state-badge');
  sb.className='state-pill s-'+radarState;
  sb.textContent=radarState.toUpperCase();
}

setInterval(function(){
  var now=performance.now();
  if(now-lastWsTime>3000&&lastWsTime>0){
    var dot=document.getElementById('tdot');
    var ghost=document.getElementById('ghost');
    dot.classList.add('stale');
    if(lastDist>0&&lastDist<=MAX_DIST){ghost.style.display='';}
    renderLiveTrail();
  }
  if(lastDetTime>0&&now-lastDetTime>60000){
    lastDetTime=0;snrEma=null;
    ['sd','scls','sang','sv','sdir','ssnr'].forEach(function(id){
      var el=document.getElementById(id);if(el){el.textContent='--';el.classList.remove('hi');}
    });
  }
},1000);

function renderSecDots(tgts,pd,pa){
  var g=document.getElementById('sec-dots');
  if(!g)return;
  if(!tgts||!tgts.length){g.innerHTML='';return;}
  var clsCol=['#8b949e','#3fb950','#f0883e'];
  var h='';
  for(var i=0;i<tgts.length;i++){
    var dd=+tgts[i].d,aa=+tgts[i].a;
    if(dd<=0||dd>MAX_DIST)continue;
    if(Math.abs(dd-pd)<0.5&&Math.abs(aa-pa)<0.5)continue;
    var p=targetSVG(dd,aa);
    var col=tgts[i].alarm?'#f0883e':(clsCol[+tgts[i].cls||0]||'#8b949e');
    h+='<circle cx="'+p.x.toFixed(1)+'" cy="'+p.y.toFixed(1)+'" r="3.5" fill="'+col+'" opacity="0.85"/>';
  }
  g.innerHTML=h;
}

function renderLiveTrail(){
  var g=document.getElementById('live-trail');
  if(!g)return;
  var now=performance.now();
  trackPoints=trackPoints.filter(function(p){return now-p.t<5000;});
  if(trackPoints.length<2){g.innerHTML='';return;}
  var h='';
  for(var i=1;i<trackPoints.length;i++){
    var p0=trackPoints[i-1],p1=trackPoints[i];
    var age=(now-p1.t)/5000,alpha=((1-age)*0.7).toFixed(2);
    var col=p1.alarm?'rgba(240,136,62,'+alpha+')':'rgba(63,185,80,'+alpha+')';
    h+='<line x1="'+p0.x.toFixed(1)+'" y1="'+p0.y.toFixed(1)+'" x2="'+p1.x.toFixed(1)+'" y2="'+p1.y.toFixed(1)+'" stroke="'+col+'" stroke-width="1.5"/>';
  }
  g.innerHTML=h;
}

function renderPinnedTrail(track){
  var g=document.getElementById('pinned-trail');
  if(!g)return;
  if(!track||track.length<2){g.innerHTML='';return;}
  var pts=track.map(function(p){return p.x.toFixed(1)+','+p.y.toFixed(1);}).join(' ');
  var last=track[track.length-1];
  var col=last.alarm?'#f0883e':'#e3b341';
  g.innerHTML='<polyline points="'+pts+'" fill="none" stroke="'+col+'" stroke-width="1.5" stroke-dasharray="3,4" opacity=".7"/>'+
    '<circle cx="'+last.x.toFixed(1)+'" cy="'+last.y.toFixed(1)+'" r="4" fill="'+col+'" opacity=".6"/>';
}

function evTrack(ev){
  if(ev.track&&ev.track.length)return ev.track;
  var d=+(ev.dist||0),a=+(ev.ang||0);
  if(d>0&&d<=MAX_DIST&&!isNaN(d)&&!isNaN(a)){var p=targetSVG(d,a);return[{x:p.x,y:p.y,alarm:!!ev.alarm}];}
  return[];
}

function renderHistTrails(){
  var g=document.getElementById('hist-trails');
  if(!g)return;
  var h='';
  detLog.forEach(function(ev,i){
    var track=evTrack(ev);
    if(!track.length)return;
    var last=track[track.length-1];
    var stroke=ev.alarm?'rgba(139,69,19,0.25)':'rgba(42,90,128,0.25)';
    var dotFill=ev.alarm?'rgba(240,136,62,0.45)':'rgba(63,185,80,0.35)';
    if(track.length>=2){
      var pts=track.map(function(p){return p.x.toFixed(1)+','+p.y.toFixed(1);}).join(' ');
      h+='<polyline points="'+pts+'" fill="none" stroke="'+stroke+'" stroke-width="1" stroke-dasharray="2,4"/>';
    }
    h+='<circle cx="'+last.x.toFixed(1)+'" cy="'+last.y.toFixed(1)+'" r="4" fill="'+dotFill+'" stroke="'+
       (ev.alarm?'rgba(240,136,62,0.6)':'rgba(63,185,80,0.5)')+'" stroke-width=".8" data-i="'+i+'"/>';
  });
  g.innerHTML=h;
}

document.getElementById('scope').addEventListener('click',function(e){
  var pt=this.createSVGPoint();
  pt.x=e.clientX;pt.y=e.clientY;
  var svgP=pt.matrixTransform(this.getScreenCTM().inverse());
  var mx=svgP.x,my=svgP.y;
  var bestIdx=-1,bestDd=Infinity;
  detLog.forEach(function(ev,i){
    evTrack(ev).forEach(function(p){
      var dx=p.x-mx,dy=p.y-my,dd=dx*dx+dy*dy;
      if(dd<bestDd){bestDd=dd;bestIdx=i;}
    });
  });
  if(bestIdx>=0&&bestDd<=900){
    selectDetRow(bestIdx);
    var row=document.querySelector('.lr[data-i="'+bestIdx+'"]');
    if(row)row.scrollIntoView({block:'nearest'});
  }else{
    pinnedTrack=null;renderPinnedTrail(null);
    document.querySelectorAll('.lr-sel').forEach(function(r){r.classList.remove('lr-sel');});
  }
});

function renderCandidates(cs){
  var el=document.getElementById('candidates');
  var ccEl=document.getElementById('ccount');
  var nmov=0;for(var i=0;i<cs.length;i++)if(cs[i].mov)nmov++;
  ccEl.textContent=cs.length?(cs.length+' dev'+(nmov?' \u00b7 '+nmov+' mov':'')):'';
  ccEl.className=cs.length?'sh-r live':'sh-r';
  el.innerHTML='';
  if(!cs.length){
    el.innerHTML='<div style="font-size:10px;color:#8b949e;padding:4px 10px">Awaiting radar trigger</div>';
    return;}
  cs.forEach(function(c){
    var pct=Math.round(c.score*100);
    var dotColor=pct>70?'var(--warn)':pct>40?'var(--gold)':'var(--bord)';
    var chLabel=c.wifi?'WiFi'+(c.ch?'\u00b7'+c.ch:''):'BLE';
    var mac=privacyMode?'XX:XX':c.mac;
    var nm=privacyMode?'REDACTED':(c.name||'');
    var mf=c.manuf||'';
    var tid=c.tid>0?'<span class="ctid">\u21ba</span>':'';
    var dir=c.mov?(c.dir>0?'<span class="sdir app" title="approaching">\u2191</span>':
                   c.dir<0?'<span class="sdir rec" title="receding">\u2193</span>':
                           '<span class="sdir" title="moving">\u2022</span>'):
                  '<span class="sdir"></span>';
    var bars=Math.max(0,Math.min(4,Math.round((c.rssi+100)/70*4)));
    var bh='';for(var b=0;b<4;b++)bh+='<i class="'+(b<bars?'on':'')+'"></i>';
    var row=document.createElement('div');
    row.className='sr'+(c.mov?' mov':'');
    row.innerHTML='<div class="si" style="background:'+dotColor+'"></div>'+
      dir+tid+
      '<span class="sp2'+(pct>40?' hi':'')+'">'+pct+'%</span>'+
      '<span class="st '+(c.wifi?'wifi':'ble')+'">'+chLabel+'</span>'+
      '<span class="sm2">'+mac+'</span>'+
      (nm?'<span class="sn2">'+nm+'</span>':'')+
      (mf?'<span class="smf">'+mf+'</span>':'')+
      '<span class="sbars">'+bh+'</span>'+
      '<span class="ss2">'+c.rssi+'</span>';
    el.appendChild(row);
  });
}

function wsSMsg(e){
  scanBusy=false;setScanBtn('idle');
  var ev=JSON.parse(e.data);
  ev.track=lastDetectionTrack.slice();
  lastCandidates=ev.candidates||[];
  renderCandidates(lastCandidates);
  if(lastClearTime!==null&&performance.now()-lastClearTime<3000)return;
  detLog.unshift(ev);
  if(detLog.length>50)detLog.pop();
  renderDetLog();
  renderGraphs();
}

function fmtUptime(t_ms){
  var s=Math.floor(t_ms/1000),m=Math.floor(s/60)%60,h=Math.floor(s/3600);
  var ss=String(s%60).padStart(2,'0'),mm=String(m).padStart(2,'0');
  return h?h+':'+mm+':'+ss:mm+':'+ss;
}

function renderDetLog(){
  var el=document.getElementById('det-log');
  document.getElementById('dlog-cnt').textContent=detLog.length;
  if(!detLog.length){el.innerHTML='';renderHistTrails();return;}
  var frags=[];
  detLog.forEach(function(ev,i){
    var t=fmtUptime(ev.t||ev.t_ms||0);
    var d=isFinite(ev.dist)&&ev.dist>0?ev.dist.toFixed(0)+'m':'--';
    var dir=ev.dir>0?'TOWARD':ev.dir<0?'AWAY':'--';
    var alm=ev.alarm?'<span class="la2">ALM</span>':'<span class="la2"></span>';
    var clsMap={1:'PERSON',2:'VEHICLE'};
    var cls=clsMap[ev.cls]||'';
    var cands=(ev.candidates||ev.c||[]);
    var nc=cands.length;
    var expCands=cands.map(function(c){
      var pct=Math.round((c.score||0)*100);
      var mac=privacyMode?'XX:XX':(c.mac||'');
      var nm=privacyMode?'REDACTED':(c.name||'');
      var ty=c.wifi?'W':'B';
      return '<div class="lexp-c"><span class="lexp-mac">'+mac+'</span>'+
        '<span class="lexp-score">'+pct+'%</span>'+
        '<span style="color:#adbac7">'+ty+'</span>'+
        '<span>'+c.rssi+'dBm</span>'+
        (nm?'<span class="lexp-name">'+nm+'</span>':'')+'</div>';
    }).join('');
    var expInner=nc?expCands:'<div class="lexp-empty">no candidates</div>';
    frags.push(
      '<div class="lr" data-i="'+i+'" data-t="'+(ev.t_ms||ev.t||0)+'" onclick="selectDetRow('+i+')">'+
        '<span class="lt">'+t+'</span>'+
        '<span class="ld">'+d+' '+dir+'</span>'+
        '<span class="lc">'+cls+'</span>'+
        alm+
        '<span class="lct">'+nc+'</span>'+
        '<span class="lr-chev">&#9658;</span>'+
      '</div>'+
      '<div class="lexp"><div class="lexp-inner">'+expInner+'</div></div>'
    );
  });
  el.innerHTML=frags.join('');
  renderHistTrails();
}

function clearDetLog(){
  if(!confirm('Clear session log and SD history?'))return;
  fetch('/api/detlog',{method:'DELETE'}).then(function(){
    lastClearTime=performance.now();
    detLog=[];pinnedTrack=null;lastDetectionTrack=[];trackPoints=[];
    lastDist=0;lastAng=0;
    renderDetLog();renderGraphs();
    renderPinnedTrail(null);
    renderLiveTrail();
    document.getElementById('tdot').style.display='none';
    document.getElementById('ghost').style.display='none';
    document.getElementById('callout').style.display='none';
    ['sd','scls','sang','sv','sdir','ssnr'].forEach(function(id){
      var el=document.getElementById(id);
      if(el){el.textContent='--';el.classList.remove('hi');}
    });
  });
}

function selectDetRow(i){
  var row=document.querySelector('.lr[data-i="'+i+'"]');
  if(!row)return;
  var wasSel=row.classList.contains('lr-sel');
  document.querySelectorAll('.lr').forEach(function(r){r.classList.remove('lr-sel');});
  row.classList.toggle('open');
  if(wasSel){
    pinnedTrack=null;
    renderPinnedTrail(null);
    if(performance.now()-lastWsTime>3000){document.getElementById('callout').style.display='none';}
    return;
  }
  row.classList.add('lr-sel');
  var ev=detLog[i];
  pinnedTrack=(ev&&ev.track&&ev.track.length)?ev.track:null;
  renderPinnedTrail(pinnedTrack);
  if(pinnedTrack&&pinnedTrack.length){
    var last=pinnedTrack[pinnedTrack.length-1];
    if(last.dist>0&&last.dist<=MAX_DIST){
      updateSVGTarget(last.dist,last.ang,last.alarm,last.cls||0,last.spd||0);
    }
  }
}
function highlightDetRow(ts){
  var idx=-1;
  detLog.forEach(function(ev,i){if((ev.t_ms||ev.t||0)===ts)idx=i;});
  if(idx<0)return;
  selectDetRow(idx);
  var row=document.querySelector('.lr[data-i="'+idx+'"]');
  if(row)row.scrollIntoView({block:'nearest'});
}

function switchTab(el,panelId){
  var tabs=document.getElementById('gtabs');
  tabs.querySelectorAll('.gtab').forEach(function(t){t.classList.remove('act')});
  el.classList.add('act');
  var sib=tabs.nextElementSibling;
  while(sib&&sib.classList.contains('gbody')){
    sib.style.display='none';
    sib=sib.nextElementSibling;
  }
  document.getElementById(panelId).style.display='';
}

function renderGraphs(){
  renderTimeline();
  renderDistanceChart();
  renderHeatmap();
}

function setChartEmpty(svgId,emptyId,show){
  var e=document.getElementById(emptyId);
  var s=document.getElementById(svgId);
  if(e)e.style.display=show?'block':'none';
  if(s)s.style.display=show?'none':'block';
}
function renderTimeline(){
  var svg=document.getElementById('chart-timeline');
  if(!detLog.length){setChartEmpty('chart-timeline','chart-timeline-empty',true);return;}
  setChartEmpty('chart-timeline','chart-timeline-empty',false);
  var now=detLog[0].t||detLog[0].t_ms||0;
  var buckets=new Array(12);
  for(var b=0;b<12;b++){buckets[b]={n:0,a:0};}
  detLog.forEach(function(ev){
    var t=ev.t||ev.t_ms||0;
    var hoursAgo=(now-t)/3600000;
    var idx=11-Math.min(11,Math.floor(hoursAgo));
    buckets[idx].n++;
    if(ev.alarm)buckets[idx].a++;
  });
  var maxN=1;
  buckets.forEach(function(b){if(b.n>maxN)maxN=b.n});
  var barW=15,gap=3,totalW=12*(barW+gap)-gap;
  var offX=(220-totalW)/2;
  var h='';
  buckets.forEach(function(b,i){
    var x=offX+i*(barW+gap);
    var bh=b.n?(b.n/maxN)*40:0;
    var col=b.a>0?'var(--hmal)':'var(--hmhi)';
    if(b.n===0)col='var(--hm0)';
    h+='<rect x="'+x+'" y="'+(44-bh)+'" width="'+barW+'" height="'+Math.max(bh,1)+'" fill="'+col+'"/>';
  });
  svg.innerHTML='<line x1="0" y1="22" x2="220" y2="22" stroke="var(--bord)" stroke-width=".5"/>'+h;
}

function renderDistanceChart(){
  var svg=document.getElementById('chart-distance');
  var recent=detLog.slice(0,20).reverse();
  if(recent.length<2){setChartEmpty('chart-distance','chart-distance-empty',true);return;}
  setChartEmpty('chart-distance','chart-distance-empty',false);
  var pts=[];
  recent.forEach(function(ev,i){
    var d=isFinite(ev.dist)?ev.dist:0;
    var x=(i/(recent.length-1))*220;
    var y=44-((d/100)*44);
    pts.push(x.toFixed(1)+','+y.toFixed(1));
  });
  var h='<line x1="0" y1="22" x2="220" y2="22" stroke="var(--bord)" stroke-width=".5" stroke-dasharray="3,4"/>';
  h+='<polyline points="'+pts.join(' ')+'" fill="none" stroke="var(--acc)" stroke-width="1.5" stroke-linejoin="round"/>';
  recent.forEach(function(ev,i){
    if(ev.alarm){
      var d=isFinite(ev.dist)?ev.dist:0;
      var x=(i/(recent.length-1))*220;
      var y=44-((d/100)*44);
      h+='<circle cx="'+x.toFixed(1)+'" cy="'+y.toFixed(1)+'" r="2.5" fill="var(--hmal)"/>';
    }
  });
  svg.innerHTML=h;
}

function renderHeatmap(){
  var svg=document.getElementById('chart-heatmap');
  if(detLog.length<3){setChartEmpty('chart-heatmap','chart-heatmap-empty',true);return;}
  setChartEmpty('chart-heatmap','chart-heatmap-empty',false);
  var rows=5,cols=7,gx=2,gy=2;
  var cw=(220-(cols-1)*gx)/cols,ch=(34-(rows-1)*gy)/rows;
  var grid=[];
  for(var r=0;r<rows;r++){grid[r]=[];for(var c=0;c<cols;c++)grid[r][c]={n:0,a:0};}
  var now=detLog[0].t||detLog[0].t_ms||0;
  var span=rows*cols;
  detLog.forEach(function(ev){
    var t=ev.t||ev.t_ms||0;
    var hoursAgo=(now-t)/3600000;
    var slot=Math.min(span-1,Math.floor(hoursAgo));
    var row=Math.floor(slot/cols);
    var col=cols-1-(slot%cols);
    if(row<rows){grid[row][col].n++;if(ev.alarm)grid[row][col].a++;}
  });
  var h='';
  for(var r=0;r<rows;r++){
    for(var c=0;c<cols;c++){
      var x=c*(cw+gx);
      var y=r*(ch+gy);
      var g=grid[r][c];
      var fill='var(--hm0)';
      if(g.n>0)fill=g.a>0?(g.a>1?'var(--hmal2)':'var(--hmal)'):(g.n>2?'var(--hmhi)':'var(--hmlo)');
      h+='<rect x="'+x+'" y="'+y+'" width="'+cw+'" height="'+ch+'" fill="'+fill+'"/>';
    }
  }
  svg.innerHTML=h;
}

function setGauge(barEl,pctEl,ratio){
  if(ratio==null||isNaN(ratio)){barEl.style.width='0%';pctEl.textContent='--';pctEl.className='tr-val';return;}
  var pct=Math.round(ratio*100);
  barEl.style.width=Math.min(ratio,1)*100+'%';
  pctEl.textContent=pct+'%';
  pctEl.className='tr-val hi';
}
function updateTraffic(d){
  var st=d.state||'idle';
  var stEl=document.getElementById('traf-state');
  var btn=document.getElementById('bl-btn');
  var prog=document.getElementById('bl-progress');
  var dpmEl=document.getElementById('traf-dpm');
  var devnEl=document.getElementById('traf-devn');
  var btn2=document.getElementById('bl-btn2');
  var sel2=document.getElementById('bl-dur2');
  if(st==='learning'){
    var el2=d.elapsed||0,tot2=d.duration||0;
    stEl.innerHTML='<span class="pill-live"><i></i>LEARNING '+el2+'/'+tot2+'s</span>';
    stEl.style.color='';
    document.getElementById('bl-elapsed').textContent=el2;
    document.getElementById('bl-total').textContent=tot2;
    prog.style.display='block';btn.textContent='Stop';blLearning=true;
    if(btn2){btn2.textContent='Stop';btn2.classList.remove('prim');}
    if(sel2)sel2.disabled=true;
    dpmEl.textContent='--';devnEl.textContent='--';
  } else if(st==='established'){
    stEl.textContent='ESTABLISHED';stEl.style.color='var(--ok)';
    prog.style.display='none';btn.textContent='Restart';blLearning=false;
    if(btn2){btn2.textContent='Restart';btn2.classList.remove('prim');}
    if(sel2)sel2.disabled=false;
    dpmEl.textContent=d.detPerMin!=null?d.detPerMin.toFixed(1):'--';
    dpmEl.className='tsi-v hi';
    var devNow=d.avgDevices!=null&&d.devRatio!=null?Math.round(d.avgDevices*d.devRatio):'--';
    devnEl.textContent=devNow;
    devnEl.className='tsi-v hi';
  } else {
    stEl.textContent='NO BASELINE';stEl.style.color='var(--mut)';
    prog.style.display='none';btn.textContent='Start Baseline';blLearning=false;
    if(btn2){btn2.textContent='Start Baseline';btn2.classList.add('prim');}
    if(sel2)sel2.disabled=false;
    dpmEl.textContent='--';dpmEl.className='tsi-v';
    devnEl.textContent='--';devnEl.className='tsi-v';
  }
  var blb=document.getElementById('bl-badge');
  if(blb){if(st==='learning'){blb.style.display='';blb.textContent='BASELINE '+(d.elapsed||0)+'/'+(d.duration||0)+'s';}else{blb.style.display='none';}}
  var sb=document.getElementById('scanBtn');
  if(sb){if(st==='learning'){sb.disabled=true;sb.textContent='Baseline';}else if(!scanBusy){sb.disabled=false;sb.textContent='Sweep now';}}
  setGauge(document.getElementById('traf-phys'),document.getElementById('traf-phys-pct'),
           st==='established'?d.physRatio:null);
  setGauge(document.getElementById('traf-dev'),document.getElementById('traf-dev-pct'),
           st==='established'?d.devRatio:null);
}
function pollBaseline(){fetch('/api/baseline').then(function(r){return r.json()}).then(updateTraffic).catch(function(){});}
setInterval(pollBaseline,2000);
pollBaseline();
function renderMesh(d){
  var peers=(d&&d.peers)||[];
  peers.sort(function(a,b){return (b.alive?1:0)-(a.alive?1:0)||String(a.id).localeCompare(String(b.id));});
  var el=document.getElementById('mesh-list');var cnt=document.getElementById('mesh-cnt');
  if(!el)return;
  var up=0;peers.forEach(function(p){if(p.alive)up++;});
  if(cnt)cnt.textContent=peers.length?(up+'/'+peers.length+' up'):'none';
  if(!peers.length){el.innerHTML='<div class="dr"><span class="dc" style="color:#484f58">no nodes seen</span></div>';return;}
  el.innerHTML=peers.map(function(p){
    var col=p.alive?'var(--ok)':'var(--mut)';
    var ms=p.age_ms||0;var age=ms<60000?Math.round(ms/1000)+'s':Math.round(ms/60000)+'m';
    var ty=p.type||'?';
    var tcol=ty==='RADAR'?'var(--gold)':(ty==='DIGI'?'var(--acc)':'var(--mut)');
    var c=[];
    if(p.radar)c.push('<span class="chip">'+p.radar+'</span>');
    c.push('<span class="chip">'+(p.dets||0)+' det</span>');
    if(p.alms)c.push('<span class="chip" style="color:var(--warn);border-color:var(--warn)">'+p.alms+' alm</span>');
    if(p.gps)c.push('<span class="chip'+(p.gps==='LOCKED'?' on':'')+'">GPS '+p.gps+'</span>');
    if(p.temp)c.push('<span class="chip">'+p.temp+'&deg;C</span>');
    return '<div class="dr"><div class="dd" style="background:'+col+'"></div>'+
      '<span class="dc">'+p.id+'</span>'+
      '<span class="state-pill" style="color:'+tcol+';border-color:'+tcol+'">'+ty+'</span>'+
      '<div class="dmeta">'+c.join('')+'</div>'+
      '<span class="dage">'+age+'</span></div>';
  }).join('');
}
function pollMesh(){fetch('/api/mesh').then(function(r){return r.json()}).then(renderMesh).catch(function(e){if(console.debug)console.debug('mesh poll fail',e);});}
setInterval(pollMesh,5000);pollMesh();
var meshBtn=document.getElementById('meshStatusBtn');
if(meshBtn)meshBtn.onclick=function(){var b=this;b.disabled=true;b.textContent='Pingingâ€¦';
  fetch('/api/mesh/status-all',{method:'POST'}).catch(function(e){if(console.debug)console.debug('status-all fail',e);}).finally(function(){
    setTimeout(function(){pollMesh();b.disabled=false;b.textContent='Ping Nodes';},2500);});};
function startBaseline(dur){
  if(blLearning){
    fetch('/api/baseline/stop',{method:'POST'}).then(pollBaseline);
  } else {
    fetch('/api/baseline/start',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({duration:dur})}).then(pollBaseline);
  }
}
function toggleBaseline(){
  startBaseline(parseInt(document.getElementById('bl-dur').value)||5);
}
function toggleBaseline2(){
  startBaseline(parseInt(document.getElementById('bl-dur2').value)||5);
}

updatePrivacyBtn();

(function(){
  var root=document.documentElement,btn=document.getElementById('themeBtn');
  var MOON='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>';
  var SUN='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"/></svg>';
  function apply(t){root.setAttribute('data-theme',t);if(btn)btn.innerHTML=(t==='dark'?SUN:MOON);}
  apply(localStorage.getItem('theme')||'dark');
  if(btn)btn.onclick=function(){
    var t=root.getAttribute('data-theme')==='dark'?'light':'dark';
    localStorage.setItem('theme',t);apply(t);
  };
})();

(function(){
  var handle=document.getElementById('rh');
  var lcol=document.getElementById('lcol');
  var dragging=false,startX,startW;
  function clampW(w){return Math.max(200,Math.min(window.innerWidth-260,w));}
  function setW(w){w=clampW(w);lcol.style.width=w+'px';return w;}
  var saved=parseInt(localStorage.getItem('lcolW'),10);
  if(saved>0)setW(saved);
  function begin(x){
    dragging=true;startX=x;startW=lcol.offsetWidth;handle.classList.add('drag');
    document.body.style.cursor='col-resize';document.body.style.userSelect='none';
  }
  function move(x){if(dragging)setW(startW+(x-startX));}
  function end(){
    if(!dragging)return;
    dragging=false;handle.classList.remove('drag');
    document.body.style.cursor='';document.body.style.userSelect='';
    localStorage.setItem('lcolW',String(lcol.offsetWidth));
  }
  handle.addEventListener('mousedown',function(e){begin(e.clientX);e.preventDefault();});
  document.addEventListener('mousemove',function(e){move(e.clientX);});
  document.addEventListener('mouseup',end);
  handle.addEventListener('touchstart',function(e){begin(e.touches[0].clientX);e.preventDefault();});
  document.addEventListener('touchmove',function(e){move(e.touches[0].clientX);});
  document.addEventListener('touchend',end);
  handle.addEventListener('dblclick',function(){localStorage.removeItem('lcolW');lcol.style.width='280px';});
  window.addEventListener('resize',function(){setW(lcol.offsetWidth);});
})();
</script>
